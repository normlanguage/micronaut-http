Module module() {
  return module(
    name: "sample.sse",
    version: 1,
    dependencies: [
      dependency(repository: "norm", name: "java.base", version: 1),
      dependency(repository: "github", name: "micronaut.core", version: 6),
      dependency(repository: "github", name: "micronaut.http", version: 6),
      dependency(repository: "github", name: "micronaut.inject", version: 15),
      dependency(repository: "github", name: "micronaut.runtime", version: 5),
      dependency(repository: "github", name: "micronaut.server.netty", version: 5),
      dependency(repository: "github", name: "micronaut.json", version: 5),
      dependency(repository: "github", name: "micronaut.serde.jackson", version: 6),
      dependency(repository: "github", name: "micronaut.inject.processor", version: 13),
      dependency(repository: "github", name: "reactor.core", version: 6)
    ]
  )
}



