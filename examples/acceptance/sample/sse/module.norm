Module module() {
  return module(
    name: "sample.sse",
    version: 1,
    dependencies: [
      dependency(repository: "github", name: "micronaut.core", version: 2),
      dependency(repository: "github", name: "micronaut.http", version: 2),
      dependency(repository: "github", name: "micronaut.inject", version: 2),
      dependency(repository: "github", name: "micronaut.runtime", version: 2),
      dependency(repository: "github", name: "micronaut.server.netty", version: 2),
      dependency(repository: "github", name: "micronaut.json", version: 2),
      dependency(repository: "github", name: "micronaut.jackson", version: 2),
      dependency(repository: "github", name: "micronaut.inject.processor", version: 2),
      dependency(repository: "github", name: "reactor.core", version: 2)
    ]
  )
}
