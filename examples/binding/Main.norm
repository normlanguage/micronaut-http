package binding

import micronaut.http.annotation.Controller
import micronaut.http.annotation.Get

@Controller("/hello")
class HelloController {
  @Get("/{name}")
  String hello(String name) {
    return "Hello, " + name
  }
}

Void main() {
  Controller? controller = HelloController.class.annotation<Controller>()
  require(condition: controller != null && controller.value == "/hello", message: "Controller binding is missing")
  require(condition: HelloController().hello("Norm") == "Hello, Norm", message: "Route handler changed")
  printLine(controller!!.value)
}
