package micronaut.http

import micronaut.http.annotation.Controller
import micronaut.http.annotation.Get

@Controller("/hello")
class HelloController {
  @Get("/{name}")
  String hello(String name) {
    return "Hello, " + name
  }
}

Void main() {
  Controller? controller = HelloController.class.annotation<Controller>()
  if controller != null {
    printLine(controller.value)
  }
}
